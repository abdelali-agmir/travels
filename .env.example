# ── Required ─────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Public URL of the app (used for sitemap/SEO)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Live providers (already working, NO KEY REQUIRED) ────
# Weather   → Open-Meteo (https://open-meteo.com)
# Currency  → Frankfurter / ECB reference rates (https://frankfurter.dev)

# ── Optional provider integrations (adapters are ready) ──
# Flights (e.g. Amadeus, Duffel, Kiwi)
# FLIGHTS_PROVIDER=Amadeus
# FLIGHTS_API_KEY=

# Accommodation (e.g. Booking.com, Amadeus Hotels, Expedia)
# HOTELS_PROVIDER=Booking.com
# HOTELS_API_KEY=

# Global places sync (e.g. Google Places, Foursquare)
# PLACES_PROVIDER=Google Places
# PLACES_API_KEY=

# Visa-rule automation (e.g. Sherpa°)
# VISA_PROVIDER=Sherpa
# VISA_API_KEY=

# LLM reasoning for the AI assistant (grounded answers work without it)
# OPENAI_API_KEY=

# Transactional email for password reset
# EMAIL_API_KEY=

# eSIM affiliate marketplace
# ESIM_AFFILIATE_KEY=
